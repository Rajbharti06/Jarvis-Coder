# Application Configuration
JARVIS_MODE="hybrid" # offline | online | hybrid
DEFAULT_MODEL="gpt-4o"
ENCRYPTION_SECRET="your-super-secret-key-for-encryption" # Should be a 32-byte URL-safe base64-encoded string

# Database Configuration
DB_URL="sqlite:///./jarvis_coder.db" # Example for PostgreSQL: "postgresql://user:password@postgresserver/db"

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key" # Should be a long, random string
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (Optional, if you want to provide system-wide keys)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""
